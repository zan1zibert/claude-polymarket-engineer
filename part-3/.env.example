# --- feeder ---
# The feeder needs only REDIS_URL (docker-compose sets it automatically to the
# in-network redis host). For running the feeder locally without Docker:
REDIS_URL=redis://localhost:6379/0

# Optional feeder tuning (defaults shown):
# POLL_INTERVAL_SECONDS=60
# FRESHNESS_WINDOW_MINUTES=30
# DEDUP_TTL_SECONDS=604800

# --- worker (market analyzer) ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
GROQ_API_KEY=gsk_...
DATABASE_URL=postgresql://pm:pm@localhost:5432/pm

# Required in prod (docker-compose.prod.yml fails fast if unset):
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192

# Optional worker tuning (defaults shown):
# VOYAGE_MODEL=voyage-3.5
# EMBEDDING_DIM=1024
# TOP_K=10
# GROQ_MODEL=llama-3.1-8b-instant
# BELIEF_DIRTY_KEY=belief_dirty
# AUDIT_LOG_PATH=outputs/belief_updates.jsonl
# WORKER_USE_WEB_SEARCH=false

# --- market-syncer (ingestion) ---
# Needs DATABASE_URL + VOYAGE_API_KEY (shared with the worker, above).
# Optional syncer tuning (compose defaults shown; uncomment to override):
# SYNC_INTERVAL_SECONDS=3600      # how often to re-sync the market set (daily)
# RESOLUTION_WINDOW_DAYS=60       # only ingest markets resolving within this
# SYNC_FETCH_LIMIT=500             # max markets pulled from Gamma per cycle
# SYNC_MIN_VOLUME_24H=5000         # ingestion volume gate
# SYNC_MIN_LIQUIDITY=10000         # ingestion liquidity gate
# SYNC_PRICE_BAND_LOW=0.05         # drop near-resolved markets (price ~0/~1)
# SYNC_PRICE_BAND_HIGH=0.95
# GAMMA_MARKETS_URL=https://gamma-api.polymarket.com/markets

# --- scorer (grades resolved markets) ---
# Needs only DATABASE_URL (shared with the worker, above). No external APIs.
# Optional scorer tuning (compose default shown; uncomment to override):
# SCORER_INTERVAL_SECONDS=3600     # how often to grade newly-resolved markets

# --- signal (belief vs live price -> paper positions) ---
# Needs DATABASE_URL + REDIS_URL (shared, above). Reads live prices from Gamma.
# Everything here is PAPER trading — no order is ever placed.
# lib/config.py's defaults are shown below. These are NOT interpolated by
# docker-compose.yml (an unset Compose var resolves to "" rather than being
# omitted, which would crash the int()/float() parsing before the default
# ever applies). To override a knob, add it explicitly to the signal
# service's `environment:` block in docker-compose.yml.
# SIGNAL_SWEEP_INTERVAL_SECONDS=3600  # settle resolved positions + rescan candidates
# SIGNAL_MIN_EDGE=0.05             # noise floor: minimum |belief - price| to act
# SIGNAL_MIN_CONVICTION_HIGH=0.80  # belief at/above this is confident enough to act
# SIGNAL_MAX_CONVICTION_LOW=0.20   # ... and at/below this
# SIGNAL_MAX_HORIZON_DAYS=14       # only bet markets resolving this soon
# SIGNAL_MIN_COST_BASIS=0.05       # THE risk dial: raise it to drop longshot bets
# SIGNAL_MAX_COST_BASIS=0.95       # defensive ceiling on the expensive side
# SIGNAL_STAKE=1.0                 # euros per paper position (flat for now)

# --- metrics (all services) ---
# Each service exposes Prometheus metrics on this port; Prometheus scrapes it
# over the internal Docker network (not published to the host).
# METRICS_PORT=8000
# GF_SECURITY_ADMIN_PASSWORD=admin   # Grafana admin password (required in prod)
