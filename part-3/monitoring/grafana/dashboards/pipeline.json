{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["polymarket", "pipeline"],
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Funnel window",
        "type": "custom",
        "query": "10m,30m,1h",
        "current": { "text": "30m", "value": "30m" },
        "options": [
          { "text": "10m", "value": "10m", "selected": false },
          { "text": "30m", "value": "30m", "selected": true },
          { "text": "1h", "value": "1h", "selected": false }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Polymarket Pipeline",
  "uid": "pm-pipeline",
  "version": 4,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "Pipeline funnel (events per ${window})",
      "description": "Each stage as a rolling count over the selected window (dropdown, top-left). The stage where the line drops off is your bottleneck.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(feeder_poll_cycles_total[$window]))", "legendFormat": "1 · poll cycles" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(feeder_articles_pushed_total[$window]))", "legendFormat": "2 · articles pushed" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(worker_articles_processed_total[$window]))", "legendFormat": "3 · articles processed" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(worker_markets_matched_total[$window]))", "legendFormat": "4 · markets matched (past gate)" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(worker_markets_reevaluated_total[$window]))", "legendFormat": "5 · markets re-evaluated" },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(worker_belief_updates_total[$window]))", "legendFormat": "6 · belief updates" },
        { "refId": "G", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(worker_belief_moved_total[$window]))", "legendFormat": "7 · belief moved (>=eps)" }
      ]
    },
    {
      "id": 2,
      "title": "Article match rate",
      "description": "Fraction of processed articles that found at least one market that passed the Groq relevance check. Low = relevance-bound (the bottleneck we discussed).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "green", "value": 0.3 }
          ] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1 - (sum(rate(worker_articles_skipped_total[30m])) / clamp_min(sum(rate(worker_articles_processed_total[30m])), 1e-9))", "legendFormat": "match rate" }
      ]
    },
    {
      "id": 3,
      "title": "News queue depth",
      "description": "Near 0 = workers starved (ingestion-bound). Growing = worker/Claude-bound.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(news_queue_depth)", "legendFormat": "queue depth" }
      ]
    },
    {
      "id": 24,
      "title": "Groq tokens/sec",
      "description": "Input vs output token throughput for the Groq relevance check — cost and rate-limit pressure.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (type) (rate(groq_tokens_total[5m]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 4,
      "title": "Claude tokens/sec",
      "description": "Input vs output token throughput — cost and rate-limit pressure.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (type) (rate(claude_tokens_total[5m]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 5,
      "title": "Voyage embedding tokens/sec",
      "description": "Query (worker) vs document (syncer) embedding token throughput.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (operation) (rate(voyage_embedding_tokens_total[5m]))", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "id": 6,
      "title": "Claude re-eval latency",
      "description": "p50 / p95 wall-clock per Claude re-evaluation call.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum(rate(claude_reeval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(claude_reeval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 7,
      "title": "Syncer activity (events/sec)",
      "description": "Market ingestion: fetched candidates, new inserts, resolutions.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(syncer_markets_fetched_total[30m]))", "legendFormat": "fetched" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(syncer_markets_inserted_total[30m]))", "legendFormat": "inserted" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(syncer_markets_resolved_total[30m]))", "legendFormat": "resolved" }
      ]
    },
    {
      "id": 8,
      "title": "RSS feeds",
      "description": "Number of feeds in the registry.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(feeder_rss_feeds)", "legendFormat": "feeds" }
      ]
    },
    {
      "id": 9,
      "title": "Belief updates / hr",
      "description": "Pipeline output rate.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(worker_belief_updates_total[30m])) * 3600", "legendFormat": "updates/hr" }
      ]
    },
    {
      "id": 10,
      "title": "Re-eval failures / hr",
      "description": "Claude calls that errored or failed to parse.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 25 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(worker_reeval_failures_total[30m])) * 3600", "legendFormat": "failures/hr" }
      ]
    },
    {
      "id": 11,
      "title": "Markets per matched article",
      "description": "Average markets returned per article that cleared the gate.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(worker_markets_matched_total[30m])) / clamp_min(sum(rate(worker_articles_processed_total[30m])) - sum(rate(worker_articles_skipped_total[30m])), 1e-9)", "legendFormat": "markets/article" }
      ]
    },
    {
      "id": 12,
      "title": "Articles pushed per feed",
      "description": "Per-minute rate of new (deduped, fresh) articles enqueued, by feed. Flat-at-zero lines are dead weight.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": {
        "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (rate(feeder_articles_pushed_total[5m])) * 60", "legendFormat": "{{source}}" }
      ]
    },
    {
      "id": 13,
      "title": "Per-feed volume (last 5m / 30m)",
      "description": "Articles fetched off each feed vs. pushed after dedup+freshness. A big fetched/pushed gap = the feed mostly re-serves stale items.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "fetched 30m" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] },
          { "matcher": { "id": "byName", "options": "pushed 30m" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "pushed 30m", "desc": true } ]
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "increase(feeder_articles_fetched_total[5m])", "format": "table", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "increase(feeder_articles_fetched_total[30m])", "format": "table", "instant": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "increase(feeder_articles_pushed_total[5m])", "format": "table", "instant": true },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "increase(feeder_articles_pushed_total[30m])", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "source", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "job": true, "instance": true, "service": true, "__name__": true },
            "indexByName": {},
            "renameByName": {
              "Value #A": "fetched 5m",
              "Value #B": "fetched 30m",
              "Value #C": "pushed 5m",
              "Value #D": "pushed 30m"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "News source conversion (over ${window})",
      "description": "Per source: articles the worker processed, how many matched a market, belief updates produced, how many actually moved the belief (>= eps), and the conversion ratios. Low match rate = the source pushes news your (politics) markets don't care about. Low yield (moved/updates) = it matches but rarely changes our score — both are candidates to drop.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "match rate" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 1 } ] },
          { "matcher": { "id": "byName", "options": "belief updates" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] },
          { "matcher": { "id": "byName", "options": "belief moved" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] },
          { "matcher": { "id": "byName", "options": "yield" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 1 } ] },
          { "matcher": { "id": "byName", "options": "updates/article" }, "properties": [ { "id": "decimals", "value": 2 } ] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "belief moved", "desc": true } ]
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_articles_processed_total[$window]))", "format": "table", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_markets_matched_total[$window]))", "format": "table", "instant": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_belief_updates_total[$window]))", "format": "table", "instant": true },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1 - sum by (source) (increase(worker_articles_skipped_total[$window])) / clamp_min(sum by (source) (increase(worker_articles_processed_total[$window])), 1e-9)", "format": "table", "instant": true },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_belief_updates_total[$window])) / clamp_min(sum by (source) (increase(worker_articles_processed_total[$window])), 1e-9)", "format": "table", "instant": true },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_belief_moved_total[$window]))", "format": "table", "instant": true },
        { "refId": "G", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (source) (increase(worker_belief_moved_total[$window])) / clamp_min(sum by (source) (increase(worker_belief_updates_total[$window])), 1e-9)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "source", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Time 6": true, "Time 7": true },
            "indexByName": {},
            "renameByName": {
              "Value #A": "processed",
              "Value #B": "markets matched",
              "Value #C": "belief updates",
              "Value #D": "match rate",
              "Value #E": "updates/article",
              "Value #F": "belief moved",
              "Value #G": "yield"
            }
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Market corpus health",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "panels": []
    },
    {
      "id": 16,
      "title": "Open markets",
      "description": "Live retrieval corpus right now (NOT closed). The headline number — a slow decline (resolves outpacing inserts) or a flat line during a stall both show here first.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_open_markets)", "legendFormat": "open" }
      ]
    },
    {
      "id": 17,
      "title": "Time since last sync",
      "description": "Staleness = now - last completed sync. A dead syncer reads the same as a quiet one on the rate panels; this is the panel that tells them apart. Thresholds assume the daily (86400s) default — retune to your SYNC_INTERVAL_SECONDS (yellow ≈ 1 missed cycle, red ≈ 2).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 53 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 90000 },
            { "color": "red", "value": 180000 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "time() - max(syncer_last_sync_timestamp_seconds)", "legendFormat": "staleness" }
      ]
    },
    {
      "id": 18,
      "title": "Awaiting outcome",
      "description": "Closed markets with no resolved_outcome — resolved but ungradeable, the scorer's dead-letter set. Nothing backfills it, so sustained growth is a signal (Gamma stopped returning determinable outcomes), not a transient.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 53 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_awaiting_outcome)", "legendFormat": "awaiting" }
      ]
    },
    {
      "id": 19,
      "title": "Closed markets",
      "description": "Resolved markets, retained for scoring (never deleted). Grows monotonically over the corpus lifetime.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_closed_markets)", "legendFormat": "closed" }
      ]
    },
    {
      "id": 20,
      "title": "Corpus size over time",
      "description": "Open vs closed vs awaiting-outcome as levels. Watch the open line for drift; watch awaiting-outcome for a creeping floor.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_open_markets)", "legendFormat": "open" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_closed_markets)", "legendFormat": "closed" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(syncer_awaiting_outcome)", "legendFormat": "awaiting outcome" }
      ]
    },
    {
      "id": 21,
      "title": "Corpus flow (per hour)",
      "description": "Inserted vs resolved per hour — the two forces on the open-market level. Inserted above resolved = corpus growing; below = shrinking. This is the readable form of the events/sec rates in the syncer-activity panel above.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(syncer_markets_inserted_total[1h])) * 3600", "legendFormat": "inserted/hr" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(syncer_markets_resolved_total[1h])) * 3600", "legendFormat": "resolved/hr" }
      ]
    },
    {
      "id": 22,
      "title": "Scorer",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 69 },
      "panels": []
    },
    {
      "id": 23,
      "title": "Time since last scorer run",
      "description": "Staleness = now - last completed scorer cycle. scorer_markets_scored_total's rate is near-zero most of the time by design (markets resolve every few days, not every cycle), so it can't tell a hung scorer from a quiet one — this panel is the one that can. Thresholds assume the hourly (3600s) default — retune to your SCORER_INTERVAL_SECONDS (yellow ≈ 1 missed cycle, red ≈ 2).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 70 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - max(scorer_last_run_timestamp_seconds)",
          "legendFormat": "staleness"
        }
      ]
    },
    {
      "id": 25,
      "title": "Claude stop_reason breakdown",
      "description": "Response finish reason per Claude re-eval call. Watch max_tokens — it means the response was truncated mid-generation, not a clean finish.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 78 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (reason) (rate(claude_stop_reason_total[30m]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 26,
      "title": "Claude max_tokens truncations / hr",
      "description": "Re-eval calls that ended on stop_reason=max_tokens — the response was cut off before the model finished. Sustained non-zero means max_tokens is set too low for this prompt/model.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 78 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(claude_stop_reason_total{reason=\"max_tokens\"}[30m])) * 3600", "legendFormat": "max_tokens/hr" }
      ]
    },
    {
      "id": 27,
      "title": "Groq relevance-check outcomes",
      "description": "Groq API calls by outcome — HTTP status code on failure, 200 on success. Watch 429 here for rate-limit pressure on the relevance check.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 86 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (code) (rate(groq_http_status_total[30m]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "id": 28,
      "title": "Groq 429s / hr",
      "description": "Rate-limit responses from the Groq relevance check. Sustained non-zero means candidates are being dropped as groq_error and worker_groq_failures_total is climbing — consider backing off request rate or upgrading the Groq tier.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 86 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(groq_http_status_total{code=\"429\"}[30m])) * 3600", "legendFormat": "429/hr" }
      ]
    }
  ]
}
